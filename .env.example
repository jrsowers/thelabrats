# ============================================================
# Fantasy League Command Center — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================

# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Account-wide; reaches every project on the account. Handle accordingly.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SECRET_KEY=

# ---- ESPN (required) ----
# League is believed public; cookies are fallback + insurance for
# auth-gated views such as mTransactions2. See AI-References/ESPN-API.md
ESPN_LEAGUE_ID=
ESPN_SEASON=2026
ESPN_SWID=
ESPN_S2=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=
ADMIN_EMAIL=

# ---- Email (required at MVP: Supabase Auth SMTP for magic links) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- AI (optional; Phase 3 weekly recap prose) ----
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Feature flags ----
DEMO_MODE=false
LOG_LEVEL=info
ENABLE_NFL_PLAY_TRACKING=false
ENABLE_AI_RECAP=false
